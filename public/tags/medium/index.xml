&gt;&lt;/p&gt;
&lt;h2 id=&#34;description&#34;&gt;
    &lt;a href=&#34;#description&#34; class=&#34;header-anchor&#34;&gt;#&lt;/a&gt;
    Description
&lt;/h2&gt;&lt;p&gt;&lt;img src=&#34;https://pho3nix-jacki3.github.io/p/exploiting-java-deserialization-with-apache-commons/img/oqiwrja938tnthAUDIHnfsiufeb.jpg&#34;
