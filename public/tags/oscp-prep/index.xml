&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;p&#34;&gt;|&lt;/span&gt;   Check &lt;span class=&#34;m&#34;&gt;3&lt;/span&gt; &lt;span class=&#34;o&#34;&gt;(&lt;/span&gt;port 4466/udp&lt;span class=&#34;o&#34;&gt;)&lt;/span&gt;: CLEAN &lt;span class=&#34;o&#34;&gt;(&lt;/span&gt;Timeout&lt;span class=&#34;o&#34;&gt;)&lt;/span&gt;
